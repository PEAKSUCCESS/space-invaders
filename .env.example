VITE_VOCAB_API_URL=https://peakvocab-api-stage-vkkf2.ondigitalocean.app
# This activity's name, used to scope its UI strings (/api/app/ui-strings).
VITE_APP_NAME=SpaceInvaders
# Shared app token for authenticated writes (enroll/answers/level/areas).
# Get the real value from Brad; it ships in the frontend bundle (public).
VITE_APP_TOKEN=
# Optional: fetch runtime game tuning (water speed, etc.) from an external URL
# instead of the bundled public/config.json, so difficulty can change with no
# redeploy. The host must allow CORS. Leave unset to use /config.json.
# VITE_CONFIG_URL=
